{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Foreverr Invitation",
  "description": "Panduan Pengguna untuk Buku Tamu Digital by Foreverr Invitation",
  "colors": {
    "primary": "#31626c",
    "light": "#3a8695",
    "dark": "#31626c"
  },
  "favicon": {
    "light": "/logo/splash.png",
    "dark": "/logo/splash.png"
  },
  "navigation": {
    "dropdowns": [
      {
        "dropdown": "Digital Guestbook",
        "icon": "book-open-reader",
        "pages": [
          "guestbook",
          "guestbook/kelola-tamu",
          "guestbook/managemen-meja",
          "guestbook/managemen-souvenir",
          "guestbook/ucapan"
        ]
      },
      {
        "dropdown": "Tutorial",
        "pages": [
          "tutorial/fitur-import-contact"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/logo-dark.png",
    "dark": "/logo/logo-light.png",
    "href": "/"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "WhatsApp",
      "href": "https://wa.me/628126666196"
    },
    "links": []
  },
  "contextual": {
    "options": [
     "copy",
    "chatgpt",
    "download-pdf",
    "assistant"
   ]
  },
  "footer": {
    "socials": {
      "instagram": "https://instagram.com/foreverr.id",
      "facebook": "https://facebook.com/foreverr.id",
      "telegram": "https://t.me/foreverrivitation"
    }
  },
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "family": "Roboto"
  },
  "icons": {
    "library": "fontawesome"
  },
  "thumbnails": {
    "appearance": "light"
  },
  "background": {
    "decoration": "windows"
  },
  "interaction": {
    "drilldown": true
  }
}
