{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Foreverr Invitation",
  "description": "Panduan Pengguna untuk user Foreverr Invitation",
  "colors": {
    "primary": "#31626C",
    "light": "#07C983",
    "dark": "#31626C"
  },
  "favicon": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png"
  },
  "navigation": {
    "dropdowns": [
      {
        "dropdown": "Digital Guestbook",
        "icon": "book-open-reader",
        "pages": [
          "guestbook",
          "kelola-tamu",
          "managemen-meja",
          "managemen-souvenir",
          "ucapan"
        ]
      },
      {
        "dropdown": "Tutorial",
        "pages": [
          "tutorial/fitur-import-contact"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/logo-dark.png",
    "dark": "/logo/logo-light.png",
    "href": "/"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "WhatsApp",
      "href": "https://wa.me/628126666196"
    },
    "links": []
  },
  "contextual": {
    "options": [
     "copy",
    "chatgpt",
    "download-pdf",
    "assistant"
   ]
  },
  "footer": {
    "socials": {
      "instagram": "https://instagram.com/foreverr.id",
      "website": "https://tiktok.com/@foreverr.id",
      "facebook": "https://facebook.com/foreverr.id"
    }
  },
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "family": "Roboto"
  },
  "icons": {
    "library": "fontawesome"
  },
  "thumbnails": {
    "appearance": "light"
  }
}
